@page "/cards"
@inject CardsService CardsService
@inject IJSRuntime JsRuntime

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <label for="iterationPath" class="form-label">Iteration Path</label>
            <input id="iterationPath" class="form-control" list="iterationOptions" @bind="iterationPath" />
            <datalist id="iterationOptions">
                @foreach (var it in iterations)
                {
                    <option value="@it"></option>
                }
            </datalist>
        </div>

        <div class="col-md-6">
            <label for="assignedTo" class="form-label">Assigned To</label>
            <input id="assignedTo" class="form-control" list="userOptions" @bind="assignedTo" />
            <datalist id="userOptions">
                @foreach (var u in users)
                {
                    <option value="@u"></option>
                }
            </datalist>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-3">
            <button class="btn btn-primary" @onclick="LoadCards">Buscar</button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center my-3">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
        </div>
    }
    @if (showClonePopup)
    {
        <div class="modal show d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Clonar Cards</h5>
                        <button type="button" class="btn-close" @onclick="()=>showClonePopup=false"></button>
                    </div>
                    <div class="modal-body">
                        <p>Selecione os tipos de clone:</p>
                        <div>
                            <input type="checkbox" @bind="cloneFront" /> Clone Front<br />
                            <input type="checkbox" @bind="cloneBff" /> Clone Bff<br />
                            <input type="checkbox" @bind="cloneApiCore" /> Clone API Core
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="()=>showClonePopup=false">Cancelar</button>
                        <button class="btn btn-primary" @onclick="ConfirmClone">OK</button>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (showEditPopup)
    {
        <div class="modal show d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Editar Cards Selecionados</h5>
                        <button type="button" class="btn-close" @onclick="()=>showEditPopup=false"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label>Story Points</label>
                            <input type="number" class="form-control" @bind="bulkStoryPoints" />
                        </div>
                        <div class="mb-3">
                            <label>State</label>
                            <select class="form-select" @bind="bulkState">
                                <option value="New">New</option>
                                <option value="Active">Active</option>
                                <option value="Resolved">Resolved</option>
                                <option value="Closed">Closed</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label>Iteration Path</label>
                            <input class="form-control" list="iterationOptions" @bind="bulkIterationPath" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="()=>showEditPopup=false">Cancelar</button>
                        <button class="btn btn-primary" @onclick="SaveBulkEdit">Salvar</button>
                    </div>
                </div>
            </div>
        </div>
    }
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th><input type="checkbox" @onchange="ToggleSelectAll" /></th>
                <th>ID</th>
                <th>Título</th>
                <th>Assigned To</th>
                <th>Story Points</th>
                <th>Iteration Path</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var card in PagedCards)
            {
                <tr>
                    <td>
                        <input type="checkbox" @bind="card.IsSelected" />
                    </td>
                    <td>@card.Id</td>
                    <td>@card.Title</td>
                    <td>@card.AssignedTo</td>
                    <td>@card.StoryPoints</td>
                    <td>@card.IterationPath</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between">
        <button class="btn btn-secondary" @onclick="PreviousPage" disabled="@(!CanGoPrevious)">Anterior</button>
        <span>Página @currentPage de @totalPages</span>
        <button class="btn btn-secondary" @onclick="NextPage" disabled="@(!CanGoNext)">Próxima</button>
    </div>

    <div class="mt-3">
        <button class="btn btn-danger" @onclick="DeleteSelected">Excluir</button>
        <button class="btn btn-warning" @onclick="EditSelected">Editar</button>
        <button class="btn btn-info" @onclick="ShowClonePopup">Clonar</button>
    </div>

</div>



@code {
    private List<Card> cards = new();
    private List<string> iterations = new();
    private List<string> users = new();
    private string iterationPath;
    private string assignedTo;
    private bool isLoading = false;
    private bool showClonePopup;
    private bool cloneFront, cloneBff, cloneApiCore;
    private bool showEditPopup = false;
    private Card? cardBeingEdited;
    private int bulkStoryPoints;
    private string bulkState;
    private string bulkIterationPath;

    // Paginação
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => (int)Math.Ceiling((double)cards.Count / pageSize);

    private IEnumerable<Card> PagedCards =>
        cards.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private bool CanGoPrevious => currentPage > 1;
    private bool CanGoNext => currentPage < totalPages;

    protected override async Task OnInitializedAsync()
    {
        iterations = await CardsService.GetIterations();
        if (iterations.Any())
            iterationPath = iterations.First().Replace(@"\Iteration\", @"\\"); // ajuste do caminho
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        bool isChecked = (bool)e.Value;
        foreach (var card in cards)
        {
            card.IsSelected = isChecked;
        }
    }

    private async Task LoadCards()
    {
        if (string.IsNullOrWhiteSpace(iterationPath))
            return;

        try
        {
            isLoading = true;
            StateHasChanged();

            // carrega Assigned Users do endpoint
            users = await CardsService.GetAssignedUsers(iterationPath);

            // carrega os cards filtrados pelo workspace específico
            cards = await CardsService.GetCards(iterationPath, assignedTo);

            currentPage = 1; // volta para primeira página
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void NextPage()
    {
        if (CanGoNext) currentPage++;
    }

    private void PreviousPage()
    {
        if (CanGoPrevious) currentPage--;
    }

    private void ShowClonePopup()
    {
        showClonePopup = true;
    }

    private async Task ConfirmClone()
    {
        var selectedCards = cards.Where(c => c.IsSelected).ToList();
        if (!selectedCards.Any()) return;

        // aqui você pode abrir outro popup de confirmação
        // e pedir o IterationPath destino
        var targetIteration = iterationPath; // ou perguntar ao usuário

        foreach (var card in selectedCards)
        {
            if (cloneFront)
            {
                var clone = new Card
                    {
                        Title = card.Title + " Front Integracao",
                        AssignedTo = "Júlio de Assis Brandão",
                        IterationPath = targetIteration,
                        StoryPoints = 3
                    };
                await CardsService.CreateCard(clone);
            }
            if (cloneBff)
            {
                var clone = new Card
                    {
                        Title = card.Title + " Bff",
                        AssignedTo = "Júlio de Assis Brandão",
                        IterationPath = targetIteration,
                        StoryPoints = 2
                    };
                await CardsService.CreateCard(clone);
            }
            if (cloneApiCore)
            {
                var clone = new Card
                    {
                        Title = card.Title + " API Core",
                        AssignedTo = "Júlio de Assis Brandão",
                        IterationPath = targetIteration,
                        StoryPoints = 3
                    };
                await CardsService.CreateCard(clone);
            }
        }

        showClonePopup = false;
        cloneFront = cloneBff = cloneApiCore = false;
        await LoadCards(); // recarregar grid
    }
    private async Task DeleteSelected()
    {
        var selectedCards = cards.Where(c => c.IsSelected).ToList();
        if (!selectedCards.Any()) return;

        // Confirmação simples (pode ser popup se quiser)
        if (!await JsRuntime.InvokeAsync<bool>("confirm", $"Deseja excluir {selectedCards.Count} cards?"))
            return;

        foreach (var card in selectedCards)
        {
            // Aqui você chama o endpoint de exclusão
            await CardsService.DeleteCard(card.Id);
        }

        // Recarregar a lista
        await LoadCards();
    }

    private async Task EditSelected()
    {
        var selectedCards = cards.Where(c => c.IsSelected).ToList();
        if (!selectedCards.Any()) return;

        // abre modal de edição em lote
        showEditPopup = true;
    }

    private async Task SaveBulkEdit()
    {
        var selectedCards = cards.Where(c => c.IsSelected).ToList();
        if (!selectedCards.Any()) return;

        foreach (var card in selectedCards)
        {
            card.StoryPoints = bulkStoryPoints;
            card.IterationPath = bulkIterationPath;
            card.State = bulkState; // precisa existir no modelo Card

            await CardsService.UpdateCard(card);
        }

        showEditPopup = false;
        await LoadCards();
    }

}
